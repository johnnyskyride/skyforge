{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyForge",
  "version": "1.0.0",
  "identifier": "com.johnnyskyride.skyforge",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "SkyForge analog instrument by @johnnyskyride",
    "longDescription": "Native SkyForge window. Patches the instrument from GitHub when you are online. Plays offline with the last copy."
  }
}
